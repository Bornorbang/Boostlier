# Frontend: the PHP origin is server-only, through the same-origin proxy.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8080
# Set cloudflare or vercel only behind that trusted edge; blank uses manual country selection.
IP_GEOLOCATION_PROVIDER=
# Private shared secret; must match ../backend/.env.
BACKEND_PROXY_SECRET=
# Optional real links only. Each is a JSON array of {"label":"...","url":"https://..."}.
BUSINESS_SOCIAL_LINKS=[]
BUSINESS_OTHER_SERVICES=[]
BUSINESS_SUPPORT_LINKS=[]
